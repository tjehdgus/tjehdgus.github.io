---
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const all = await getCollection('posts', (p) => p.data.lang === 'en' && !p.data.draft);
  return all.map((p) => ({ params: { key: p.data.key } }));
}
const { key } = Astro.params;
return Astro.redirect(`/posts/${key}/`, 301);
---
