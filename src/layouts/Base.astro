---
import '../styles/global.css';
import { ui, TISTORY, GITHUB, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  section?: 'home' | 'about' | 'projects' | 'posts';
  alt: string; // URL of the same page in the other language
}
const { lang, title, description, section = 'home', alt } = Astro.props;
const t = ui[lang];
const base = lang === 'ko' ? '' : '/en';
const siteTitle = lang === 'ko' ? '서동현 · AI 엔지니어' : 'Donghyun Seo · AI Engineer';
const fullTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const desc = description ?? t.heroDesc;
const links = [
  { key: 'about', href: `${base}/about/`, label: t.nav.about },
  { key: 'projects', href: `${base}/projects/`, label: t.nav.projects },
  { key: 'posts', href: `${base}/posts/`, label: t.nav.posts },
] as const;
const canonical = new URL(Astro.url.pathname, Astro.site);
const altLang = lang === 'ko' ? 'en' : 'ko';
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={altLang} href={new URL(alt, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" />
    <script is:inline>
      try { var s = localStorage.getItem('dong-theme'); document.documentElement.setAttribute('data-theme', s === 'light' ? 'light' : 'dark'); } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={`${base}/`}><span class="mark">D</span><span>{t.name}</span></a>
        <nav class="nav" aria-label="main">
          {links.map((l) => <a class="nav-link" href={l.href} aria-current={section === l.key ? 'page' : undefined}>{l.label}</a>)}
          <button class="icon-btn" id="themeToggle" type="button" aria-label={t.themeToggle}>
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <a class="lang-btn" href={alt} hreflang={altLang} lang={altLang}>{t.langSwitch}</a>
        </nav>
      </div>
      <nav class="mobile-nav" aria-label="mobile">
        {links.map((l) => <a href={l.href} aria-current={section === l.key ? 'page' : undefined}>{l.label}</a>)}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {t.name}</span>
        <nav>
          <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
          <a href={TISTORY} target="_blank" rel="noopener">Tistory</a>
          <a href={`${base}/rss.xml`}>RSS</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var b = document.getElementById('themeToggle');
        if (!b) return;
        b.addEventListener('click', function () {
          var r = document.documentElement;
          var next = r.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          r.setAttribute('data-theme', next);
          try { localStorage.setItem('dong-theme', next); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
