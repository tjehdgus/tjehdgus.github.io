---
import { ui, type Lang, type Project } from '../data/site';
interface Props { p: Project; lang: Lang }
const { p, lang } = Astro.props;
const t = ui[lang];
const base = lang === 'ko' ? '/ko' : '';
---
<article class="card">
  <div class="card-top"><span>{t.groups[p.group]}</span>{p.period && <span>{p.period}</span>}</div>
  <h3>{p.title[lang]}</h3>
  <p>{p.summary[lang]}</p>
  <div class="result"><b>{t.result}</b>{p.result[lang]}</div>
  <div class="tags">{p.stack.map((s) => <span class="tag">{s}</span>)}</div>
  <div class="links">
    {p.postKey && <a href={`${base}/posts/${p.postKey}/`}>{lang === 'ko' ? '기술 리포트' : 'Technical report'}</a>}
    {p.posts[0] && <a href={p.posts[0]} target="_blank" rel="noopener">{t.readOn} ↗</a>}
    {p.repo && <a href={p.repo} target="_blank" rel="noopener">{t.code} ↗</a>}
  </div>
</article>
