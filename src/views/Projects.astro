---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { ui, projects, type Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const order = ['rag', 'service', 'comp', 'work'] as const;
---
<Base lang={lang} section="projects" title={t.nav.projects} alt={lang === 'ko' ? '/en/projects/' : '/projects/'}>
  <div class="wrap">
    <header class="page-head"><h1>{t.nav.projects}</h1><p>{t.projectsIntro}</p></header>
    {order.map((g) => (
      <>
        <h2 class="group-title">{t.groups[g]}</h2>
        <div class="grid">{projects.filter((p) => p.group === g).map((p) => <ProjectCard p={p} lang={lang} />)}</div>
      </>
    ))}
  </div>
</Base>
